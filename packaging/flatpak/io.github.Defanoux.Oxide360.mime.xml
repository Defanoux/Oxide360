<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-oxide360">
    <comment>Oxide360 design</comment>
    <icon name="io.github.Defanoux.Oxide360"/>
    <glob pattern="*.ox360"/>
    <glob pattern="*.ocad"/>
  </mime-type>
  <!-- OpenSCAD scripts open as solids (Open With > Oxide360). -->
  <mime-type type="application/x-openscad">
    <comment>OpenSCAD script</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.scad"/>
  </mime-type>
</mime-info>
